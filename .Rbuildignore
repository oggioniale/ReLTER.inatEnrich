# RStudio project files
^.*\.Rproj$
^\.Rproj\.user$

# Git
^\.git$
^\.gitignore$
^\.github$
# Documentation sources
^README\.Rmd$
^LICENSE\.md$
# pkgdown
^_pkgdown\.yml$
^pkgdown$
^docs$
